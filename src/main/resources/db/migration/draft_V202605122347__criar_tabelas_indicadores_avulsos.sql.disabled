-- =========================================================
-- TABELA: indicador_avulso
-- =========================================================

CREATE TABLE indicador_avulso (

    id                  INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    nome_indicador      VARCHAR(2000),
    unidade_medida      VARCHAR(2000),
    fonte_indicador     VARCHAR(2000),
    medido_por          VARCHAR(2000),
    base_de_referencia  VARCHAR(2000),

    id_tipo_status      INTEGER NOT NULL,

    apagado             BOOLEAN NOT NULL DEFAULT FALSE,

    criado_em           TIMESTAMP,
    atualizado_em       TIMESTAMP,
    criado_por          VARCHAR(255),
    atualizado_por      VARCHAR(255)
);


-- =========================================================
-- FK: indicador_avulso -> tipo_status
-- =========================================================

ALTER TABLE indicador_avulso
ADD CONSTRAINT fk_indicador_avulso_tipo_status
FOREIGN KEY (id_tipo_status)
REFERENCES tipo_status(id);


-- =========================================================
-- TABELA: indicador_avulso_meta
-- =========================================================

CREATE TABLE indicador_avulso_meta (

    id                  INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_indicador        INTEGER NOT NULL,

    ano                 INTEGER,

    valor               NUMERIC(19,2),

    id_tipo_status      INTEGER NOT NULL,

    apagado             BOOLEAN NOT NULL DEFAULT FALSE,

    criado_em           TIMESTAMP,
    atualizado_em       TIMESTAMP,
    criado_por          VARCHAR(255),
    atualizado_por      VARCHAR(255)
);


-- =========================================================
-- FK: indicador_avulso_meta -> indicador_avulso
-- =========================================================

ALTER TABLE indicador_avulso_meta
ADD CONSTRAINT fk_indicador_avulso_meta_indicador
FOREIGN KEY (id_indicador)
REFERENCES indicador_avulso(id);


-- =========================================================
-- FK: indicador_avulso_meta -> tipo_status
-- =========================================================

ALTER TABLE indicador_avulso_meta
ADD CONSTRAINT fk_indicador_avulso_meta_tipo_status
FOREIGN KEY (id_tipo_status)
REFERENCES tipo_status(id);


-- =========================================================
-- TABELA: projeto_indicador_avulso
-- RELAÇÃO:
-- projeto <-> indicador_avulso
-- =========================================================

CREATE TABLE projeto_indicador_avulso (

    id                          INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_projeto                  INTEGER NOT NULL,

    id_indicador_avulso         INTEGER NOT NULL,

    id_tipo_status              INTEGER NOT NULL,

    apagado                     BOOLEAN NOT NULL DEFAULT FALSE,

    criado_em                   TIMESTAMP,
    atualizado_em               TIMESTAMP,
    criado_por                  VARCHAR(255),
    atualizado_por              VARCHAR(255)
);


-- =========================================================
-- FK: projeto_indicador_avulso -> projeto
-- =========================================================

ALTER TABLE projeto_indicador_avulso
ADD CONSTRAINT fk_projeto_indicador_avulso_projeto
FOREIGN KEY (id_projeto)
REFERENCES projeto(id);


-- =========================================================
-- FK: projeto_indicador_avulso -> indicador_avulso
-- =========================================================

ALTER TABLE projeto_indicador_avulso
ADD CONSTRAINT fk_projeto_indicador_avulso_indicador
FOREIGN KEY (id_indicador_avulso)
REFERENCES indicador_avulso(id);


-- =========================================================
-- FK: projeto_indicador_avulso -> tipo_status
-- =========================================================

ALTER TABLE projeto_indicador_avulso
ADD CONSTRAINT fk_projeto_indicador_avulso_tipo_status
FOREIGN KEY (id_tipo_status)
REFERENCES tipo_status(id);


-- =========================================================
-- TABELA: projeto_indicador_avulso_meta
-- METAS ESPECÍFICAS DO PROJETO
-- =========================================================

CREATE TABLE projeto_indicador_avulso_meta (

    id                              INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_projeto_indicador_avulso     INTEGER NOT NULL,

    ano                             INTEGER,

    valor                           NUMERIC(19,2),

    id_tipo_status                  INTEGER NOT NULL,

    apagado                         BOOLEAN NOT NULL DEFAULT FALSE,

    criado_em                       TIMESTAMP,
    atualizado_em                   TIMESTAMP,
    criado_por                      VARCHAR(255),
    atualizado_por                  VARCHAR(255)
);

-- =========================================================
-- FK: projeto_indicador_avulso_meta -> projeto_indicador_avulso
-- =========================================================
ALTER TABLE projeto_indicador_avulso_meta
ADD CONSTRAINT fk_projeto_indicador_avulso_meta
FOREIGN KEY (id_projeto_indicador_avulso)
REFERENCES projeto_indicador_avulso(id);
