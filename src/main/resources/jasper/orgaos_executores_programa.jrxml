<!-- Created with Jaspersoft Studio version 7.0.0.final using JasperReports Library version 7.0.0  -->
<jasperReport name="orgaos_executores_programa" language="java" pageWidth="535" pageHeight="842" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="88ff3a60-9e8a-449e-a525-ee0f352cf53c">
	<parameter name="idPrograma" class="java.lang.Long"/>
	<query language="sql"><![CDATA[select distinct
 nome_fantasia || ' - ' || regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(initcap(org.nome), '\mDe\M', 'de', 'g'), '\mDa\M', 'da', 'g'), '\mDo\M', 'do', 'g'), '\mDos\M', 'dos', 'g'), '\mDas\M', 'das', 'g') as nome_organizacao,
 org.cnpj as cnpj,
 case when porg.tipo_organizacao = 1 then 'Gestor' when porg.tipo_organizacao = 2 then 'Executor' else '' end as tipo_organizacao
 from programa prog
 right join programa_organizacao porg on porg.id_programa = prog.id
 join organizacao org on org.id = porg.id_organizacao
 where (org.apagado = false) and prog.apagado = false and prog.id = $P{idPrograma}]]></query>
	<field name="nome_organizacao" class="java.lang.String"/>
	<field name="cnpj" class="java.lang.String"/>
	<field name="tipo_organizacao" class="java.lang.String"/>
	<detail>
		<band height="18" splitType="Stretch">
			<element kind="textField" uuid="7fa90604-e17f-45b4-ba29-196bfb748668" x="100" y="0" width="303" height="18" forecolor="#0A588F" textAdjust="StretchHeight">
				<expression><![CDATA[$F{nome_organizacao}]]></expression>
			</element>
			<element kind="textField" uuid="b0588d9b-6c32-408e-871b-1ed261c5a505" x="0" y="0" width="98" height="18" forecolor="#0A588F">
				<expression><![CDATA[($F{cnpj} != null && $F{cnpj}.length() >= 14 ? String.valueOf($F{cnpj}).substring(0,2) + "." + String.valueOf($F{cnpj}).substring(2,5) + "." + String.valueOf($F{cnpj}).substring(5,8) + "/" + String.valueOf($F{cnpj}).substring(8,12) + "-" + String.valueOf($F{cnpj}).substring(12) : "CNPJ INVÁLIDO")]]></expression>
			</element>
			<element kind="textField" uuid="89f2bb8a-dfa5-4571-b6a4-e738bbfd929a" x="413" y="0" width="120" height="18" forecolor="#0A588F">
				<expression><![CDATA[$F{tipo_organizacao}]]></expression>
			</element>
		</band>
	</detail>
</jasperReport>
