<!-- Created with Jaspersoft Studio version 7.0.0.final using JasperReports Library version 7.0.0  -->
<jasperReport name="rateio" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b75064df-8341-410e-b45d-d8883c781f57">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Siscap Hml"/>
	<parameter name="idProjeto" class="java.lang.Integer"/>
	<parameter name="pathRelatorios" class="java.lang.String">
		<defaultValueExpression><![CDATA["."]]></defaultValueExpression>
	</parameter>
	<query language="plsql"><![CDATA[
        SELECT
            pa.id AS id_projeto_acao,
            pa.acao_principal,
            pa.valor_estimado,
            pa.descricao_acoes_secundarias,
            palq.id_localidade,

            CASE
                WHEN loc.tipo = 'Estado' THEN 'Todo o Estado'
                ELSE loc.nome
            END AS nome_localidade,

            loc.tipo AS tipo_localidade,
            palq.percentual,
            palq.quantia,
            DENSE_RANK() OVER (ORDER BY pa.id) AS numero_acao

        FROM projeto_acao pa

        LEFT JOIN projeto_acao_localidade_quantia palq
               ON palq.id_projeto_acao = pa.id
              AND palq.apagado = false

        LEFT JOIN localidade loc
               ON loc.id = palq.id_localidade

        WHERE pa.id_projeto = $P{idProjeto}
          AND pa.apagado = false

        ORDER BY
            pa.id,
            CASE loc.tipo
                WHEN 'Estado' THEN 1
                WHEN 'Microrregiao' THEN 2
                WHEN 'Municipio' THEN 3
                ELSE 4
            END,
            loc.nome
    ]]></query>
	<field name="id_projeto_acao" class="java.lang.Integer"/>
	<field name="acao_principal" class="java.lang.String"/>
	<field name="valor_estimado" class="java.math.BigDecimal"/>
	<field name="descricao_acoes_secundarias" class="java.lang.String"/>
	<field name="id_localidade" class="java.lang.Long"/>
	<field name="nome_localidade" class="java.lang.String"/>
	<field name="tipo_localidade" class="java.lang.String"/>
	<field name="percentual" class="java.math.BigDecimal"/>
	<field name="quantia" class="java.math.BigDecimal"/>
	<field name="numero_acao" class="java.lang.Long"/>
